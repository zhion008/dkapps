# Instagram credentials (required for Instagram scraping)
INSTAGRAM_USERNAME=your_instagram_username
INSTAGRAM_PASSWORD=your_instagram_password
# Optional: Use a session ID instead of username/password
# INSTAGRAM_SESSION_ID=your_session_id

# YouTube Data API v3 (optional - yt-dlp works without it)
# Used for quota-efficient search and comment fetching
YOUTUBE_API_KEY=your_youtube_api_key

# TikTok session value (ms_token cookie - improves reliability)
# Obtain by logging into TikTok in a browser and copying the ms_token cookie
TIKTOK_MS_TOKEN=

# API settings
API_HOST=0.0.0.0
API_PORT=8000
API_DEBUG=false

# Cache TTL in seconds
CACHE_TTL=300

# Rate limiting (requests per minute per platform)
INSTAGRAM_RATE_LIMIT=30
TIKTOK_RATE_LIMIT=60
YOUTUBE_RATE_LIMIT=100
